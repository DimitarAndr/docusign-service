NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://username:password@localhost:5432/docusign?schema=public"

# DocuSign JWT Configuration
DOCUSIGN_INTEGRATION_KEY=your_integration_key
DOCUSIGN_USER_ID=your_user_id
DOCUSIGN_AUTH_SERVER=https://account-d.docusign.com
DOCUSIGN_SCOPES=signature impersonation
DOCUSIGN_PRIVATE_KEY_PATH=./keys/private.pem
DOCUSIGN_TOKEN_EXPIRATION=3600
